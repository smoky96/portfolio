APP_ENV=prod
DATABASE_URL=postgresql+psycopg2://portfolio:REPLACE_ME@managed-pg.example.com:5432/portfolio

BASE_CURRENCY=CNY
DEFAULT_TIMEZONE=Asia/Shanghai
DRIFT_ALERT_THRESHOLD=0.05
QUOTE_PROVIDER=yahoo
YAHOO_QUOTE_URL=https://query1.finance.yahoo.com/v7/finance/quote
QUOTE_REFRESH_HOUR=18
QUOTE_REFRESH_MINUTE=0
QUOTE_REFRESH_INTERVAL_MINUTES=5
QUOTE_AUTO_REFRESH_STALE_MINUTES=5
QUOTE_AUTO_REFRESH_ON_READ=false
QUOTE_HISTORY_BACKFILL_DAYS=365
QUOTE_HISTORY_BACKFILL_MIN_POINTS=2
QUOTE_HISTORY_BACKFILL_COOLDOWN_MINUTES=60

JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

ALLOW_SELF_REGISTRATION=false
EXPOSE_API_DOCS=false
CORS_ALLOWED_ORIGINS=https://portfolio.example.com
COOKIE_NAME=portfolio_session
COOKIE_SECURE=true
COOKIE_DOMAIN=portfolio.example.com
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_PER_MIN=5

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
BOOTSTRAP_ADMIN_INVITE_CODE=REPLACE_WITH_UNIQUE_INVITE
VITE_ALLOW_SELF_REGISTRATION=false

NGINX_PORT=8080

POSTGRES_HOST=managed-pg.example.com
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=REPLACE_ME

BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_BACKUP_KEY
S3_BUCKET=portfolio-prod-backups
S3_PREFIX=portfolio
KEEP_LOCAL_BACKUPS=false
AWS_REGION=us-east-1

# For docker-compose.prod.yml:
#   ENV_FILE=.env.prod docker compose -f docker-compose.prod.yml up -d --build
